{
  "name": "@owc/components",
  "version": "1.6.0",
  "type": "module",
  "main": "dist/owc.js",
  "module": "dist/owc.js",
  "exports": {
    ".": {
      "import": "./dist/owc.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "dev": "vite",
