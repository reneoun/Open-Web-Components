    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.1",
    "happy-dom": "^20.8.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.1"
  }
